@using HoraCerta.Models.Shared
@model HoraCerta.Models.ProfissionalViewModel

@{
    ViewData["Title"] = "Criar Profissional";
}

<section class="container-fluid">
    <header class="mb-4">
        <h1 class="display-6">@ViewData["Title"]</h1>
        <p class="text-muted">Preencha os dados abaixo para cadastrar um novo profissional.</p>
    </header>

    <main>
        <form id="formProfissional" asp-action="Criar" method="post">
            <div class="row">
                <div class="col-sm-4">
                    <div class="mb-3">
                        <label asp-for="Nome" class="form-label">Nome<span class="text-danger">*</span></label>
                        <input asp-for="Nome" class="form-control" />
                        <span asp-validation-for="Nome" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="mb-3">
                        <label asp-for="Sobrenome" class="form-label">Sobrenome<span class="text-danger">*</span></label>
                        <input asp-for="Sobrenome" class="form-control" />
                        <span asp-validation-for="Sobrenome" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-sm-2">
                    <div class="mb-3">
                        <label asp-for="Telefone" class="form-label"></label>
                        <input asp-for="Telefone" class="form-control" id="telefone" placeholder="(DD) 9 XXXX-XXXX" />
                        <span asp-validation-for="Telefone" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-sm-2">
                    <div class="mb-3">
                        <label asp-for="WhatsApp" class="form-label">WhatsApp<span class="text-danger">*</span></label>
                        <input asp-for="WhatsApp" class="form-control" id="whatsApp" placeholder="+55 (DD) 9 XXXX-XXXX" />
                        <span asp-validation-for="WhatsApp" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-sm-4">
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label">E-mail<span class="text-danger">*</span></label>
                        <input asp-for="Email" class="form-control" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>
                </div>
                <div class="col-sm-4">
                    <div class="mb-3">
                        <label asp-for="Instagram" class="form-label"></label>
                        <input asp-for="Instagram" class="form-control" id="instagram" placeholder="Ex: @@nomeUsuarioInstagram" />
                        <span asp-validation-for="Instagram" class="text-danger"></span>
                    </div>
                </div>
            </div>

            <div class="row align-items-start">
                <!-- Dropdown -->
                <div class="col-sm-4">
                    <div class="mb-3">
                        <label asp-for="EspecialidadesIdSelecionadas" class="form-label fw-semibold">
                            Especialidades <span class="text-danger">*</span>
                        </label>
                        <select id="especialidadesSelect" asp-for="EspecialidadesIdSelecionadas" asp-items="Model.Especialidades" class="form-select shadow-sm">
                            <option value="">Selecione uma especialidade</option>
                        </select>
                        <span asp-validation-for="EspecialidadesIdSelecionadas" class="text-danger"></span>
                    </div>
                </div>

                <!-- Exibição das selecionadas -->
                <div class="col-sm-8">
                    <div class="card shadow-sm border-0">
                        <div class="card-header bg-light py-2">
                            <h6 class="mb-0 text-secondary">Especialidades Selecionadas</h6>
                        </div>
                        <div class="card-body py-3" id="especialidadesSelecionadas">
                            <p id="txtSemEspecialidade" class="text-muted mb-0 small">Nenhuma especialidade selecionada.</p>
                        </div>
                    </div>

                    <!-- Campo oculto -->
                    <input type="hidden" name="EspecialidadesSelecionadas" id="especialidadesHidden" />
                    <span asp-validation-for="EspecialidadesSelecionadas" class="text-danger small"></span>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="mb-3">
                        <label asp-for="Observacao" class="form-label">Observação:</label>
                        <textarea asp-for="Observacao" class="form-control" placeholder="Descreva alguma observação relevante sobre o profissional, se achar necessário."></textarea>
                        <span asp-validation-for="Observacao" class="text-danger"></span>
                    </div>
                </div>
            </div>

            @await Html.PartialAsync("_FormButtons", new FormButtonsViewModel { ButtonText = "Salvar", BackAction = "Listar" })
        </form>
    </main>
</section>

@section Scripts {
    @{
        //Comentado a _validationScriptsPartial para pegar a validação do jquery
        // await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
    <!-- jQuery (necessário para o Inputmask funcionar com $) -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.6.0/jquery.min.js"></script>

    <!-- Biblioteca Inputmask -->
    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery.inputmask/5.0.8/jquery.inputmask.min.js"></script>
    <script src="~/js/profissional/criar.js"></script>
}
